# Bot credentials — from Discord Developer Portal → Bot → Token
BOT_TOKEN=your_bot_token_here

# Application ID — from Discord Developer Portal → General Information
CLIENT_ID=your_client_id_here

# Your server's ID — right-click server icon → Copy Server ID
GUILD_ID=your_guild_id_here

# Channel IDs — right-click channel → Copy Channel ID
MOD_LOG_CHANNEL_ID=
ANNOUNCEMENTS_CHANNEL_ID=
ONBOARDING_CHANNEL_ID=
PROJECTS_CHANNEL_ID=
EVENTS_CHANNEL_ID=

# Role IDs — Server Settings → Roles → right-click role → Copy Role ID
COMMITTEE_ROLE_ID=
MOD_ROLE_ID=

# Database
DB_PATH=./data/bot.db

# Environment
NODE_ENV=development
