# Bot credentials — from Discord Developer Portal → Bot → Token
BOT_TOKEN=your_bot_token_here

# Application ID — from Discord Developer Portal → General Information
CLIENT_ID=your_client_id_here

# Your server's ID — right-click server icon → Copy Server ID
GUILD_ID=your_guild_id_here

# Internal SQLite (config, tickets, onboarding, invite tracking)
DB_PATH=./data/bot.db

# Shared Postgres — the "public subgraph" (members, projects, events,
# announcements) that the website also reads. Connect as the cbc_bot role.
DATABASE_URL=postgres://cbc_bot:cbc_bot_dev@localhost:5433/cbc

# Website revalidation hook — the bot POSTs here after writing shared data so
# changes show up on the site immediately. Leave blank to disable.
WEBSITE_BASE_URL=http://localhost:8443
WEBSITE_REVALIDATE_URL=http://localhost:8443/api/revalidate
WEBSITE_REVALIDATE_SECRET=dev_revalidate_secret_change_me

# Optional: raises the GitHub API rate limit used for project tag derivation
# (60/hr anonymous → 5000/hr). A fine-grained token with public read access.
GITHUB_TOKEN=

# Environment
NODE_ENV=development

# Channel and role IDs are configured at runtime via the /setup command (admin only).
# No hardcoded IDs needed here.
